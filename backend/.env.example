# Backend Environment Variables
# ============================
# Copy this file to .env and fill in your values

# Database (PostgreSQL)
# -------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=offerpath
DB_USER=postgres
DB_PASSWORD=your_password_here

# Or use full connection string (comment out above if using this)
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/offerpath

# Server
# ------
HOST=127.0.0.1
PORT=8000

# CORS (Origins allowed to access API)
# -----------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret Key (for JWT tokens - generate a random string in production)
# --------------------------------------------------------
SECRET_KEY=your-secret-key-change-in-production
REFRESH_SECRET_KEY=your-refresh-secret-key-change-in-production

# Debug mode
# ---------
DEBUG=true